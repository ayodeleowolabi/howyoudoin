<%- include('../partials/header.ejs', { title: 'Weekly reviews' }) %>
<section class="page-head row">
  <div>
    <p class="eyebrow">Your check-ins</p>
    <h1>Weekly reviews</h1>
  </div>
  <% if (reviews.length) { %><a href="/student/reviews/new" class="btn btn-primary">+ New review</a><% } %>
</section>

<% if (!reviews.length) { %>
  <section class="empty card" data-testid="empty-reviews">
    <span class="feature-icon" aria-hidden="true">🌱</span>
    <h2>You have no reviews yet</h2>
    <p class="muted">Start with this week. It only takes a minute.</p>
    <a href="/student/reviews/new" class="btn btn-primary">Write your first review</a>
  </section>
<% } else { %>
  <ul class="grid grid-3 review-list" role="list">
    <% reviews.forEach(review => { %>
      <li>
        <a href="/student/reviews/<%= review._id %>" class="card review-card" data-testid="review-card">
          <div class="row">
            <h2><%= review.weekNumber %></h2>
            <%- include('../partials/rating-chip.ejs', { score: review.score }) %>
          </div>
          <div class="meter" aria-hidden="true"><span class="meter-fill rating-<%= review.score %>" style="width: <%= review.score * 25 %>%"></span></div>
          <p class="muted clamp"><%= review.weeklyReview || 'No notes added.' %></p>
          <p class="date"><%= review.createdAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
        </a>
      </li>
    <% }) %>
  </ul>
<% } %>
<%- include('../partials/footer.ejs') %>
