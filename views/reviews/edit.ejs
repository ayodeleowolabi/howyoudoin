<%- include('../partials/header.ejs', { title: 'Edit review' }) %>
<section class="page-head">
  <p class="eyebrow">Weekly check-in</p>
  <h1>Edit <%= review.weekNumber %></h1>
</section>
<div class="card narrow">
  <%- include('./_form.ejs', {
    action: '/student/reviews/' + review._id + '?_method=PUT',
    submitLabel: 'Save changes',
    cancelHref: '/student/reviews/' + review._id,
    weeks: Review.WEEKS, ratings: Review.RATINGS, labels: Review.RATING_LABELS,
  }) %>
</div>
<%- include('../partials/footer.ejs') %>
